#!/bin/bash
# Set the current background
THEMES_DIR="$HOME/.config/themes"
CURRENT="$THEMES_DIR/current"

if [[ -z "$1" ]]; then
  echo "Usage: theme-bg-set <image-path>"
  exit 1
fi

BG_PATH="$1"

if [[ ! -f "$BG_PATH" ]]; then
  echo "Error: File not found: $BG_PATH"
  exit 1
fi

# Copy to current backgrounds
mkdir -p "$CURRENT/backgrounds"
BG_NAME=$(basename "$BG_PATH")
DEST="$CURRENT/backgrounds/$BG_NAME"

# theme-bg-next passes files that are already in the current directory.
if [[ "$(readlink -f -- "$BG_PATH")" != "$(readlink -f -- "$DEST" 2>/dev/null)" ]]; then
  cp -- "$BG_PATH" "$DEST"
fi

# Update background symlink
ln -sfn -- "$DEST" "$CURRENT/background"

# Update hyprlock and autostart if they reference backgrounds
HYPRLOCK="$HOME/.config/hypr/hyprlock.conf"
if [[ -f "$HYPRLOCK" ]]; then
  sed -i "s|path = .*|path = ~/.config/themes/current/backgrounds/$BG_NAME|" "$HYPRLOCK"
fi

AUTOSTART="$HOME/.config/hypr/autostart.conf"
if [[ -f "$AUTOSTART" ]]; then
  sed -i "s|swaybg -i .*|swaybg -i ~/.config/themes/current/backgrounds/$BG_NAME -m fill|" "$AUTOSTART"
fi

# Replace the running wallpaper immediately instead of waiting for Hyprland
# to restart or reload its autostart entries.
if command -v swaybg >/dev/null; then
  pkill -x swaybg 2>/dev/null || true
  swaybg -i "$CURRENT/background" -m fill >/dev/null 2>&1 &
  disown
fi

echo "Background set: $BG_NAME"
